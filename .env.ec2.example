# Plantilla para despliegue en EC2 (Amazon Linux / Ubuntu).
# Uso en la instancia:
#   cp .env.ec2.example .env
#   # Edita APP_URL, CORS_ORIGINS, DB_PASSWORD y JWT_SECRET
#   just setup-prod
#
# O ejecuta el script automatizado:
#   bash deploy/ec2/setup-ec2.sh

APP_NAME="FEROMAP"
APP_ENV=production
APP_DEBUG=false

# Sustituye por la IP pública o dominio de tu EC2 (sin barra final).
APP_URL=http://TU_IP_O_DOMINIO

COMPOSE_ENV=prod
COMPOSE_PROJECT_NAME=feromap

API_PORT=8000
FRONTEND_PORT=8080
DB_HOST_PORT=5432

DB_HOST=db
DB_PORT=5432
DB_DATABASE=feromap
DB_USERNAME=feromap
# Genera una contraseña fuerte: openssl rand -base64 24
DB_PASSWORD=CAMBIAR_CONTRASEÑA_BD

DATABASE_URL=postgresql+psycopg://feromap:CAMBIAR_CONTRASEÑA_BD@db:5432/feromap

# Debe coincidir con APP_URL (mismo origen que el navegador).
CORS_ORIGINS=http://TU_IP_O_DOMINIO

# Vacío: el SPA usa /api en el mismo origen (Nginx contenedor → api:8000)
VITE_API_URL=
VITE_USE_MOCKS=false

# Genera un secreto fuerte: openssl rand -hex 32
JWT_SECRET=CAMBIAR_JWT_SECRET
JWT_EXPIRE_MINUTES=1440
JWT_COOKIE_NAME=feromap_access_token

DATA_DIR=./data

# Motor ACO (ajusta según RAM de la instancia; t3.medium recomendado)
ACO_ANTS=12
ACO_ITERATIONS=20
ACO_PATIENCE=5
ACO_PARALLEL_WORKERS=0
OPTIMIZATION_MAX_WORKERS=2
VITE_ACO_PRESET_DEFAULT=precise
