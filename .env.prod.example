# Plantilla para producción local / defensa de grado.
# Uso: cp .env.prod.example .env   &&   just rebuild-prod

APP_NAME="FEROMAP"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

COMPOSE_ENV=prod
COMPOSE_PROJECT_NAME=feromap

API_PORT=8000
FRONTEND_PORT=8080
DB_HOST_PORT=5432

DB_HOST=db
DB_PORT=5432
DB_DATABASE=feromap
DB_USERNAME=feromap
DB_PASSWORD=feromap

DATABASE_URL=postgresql+psycopg://feromap:feromap@db:5432/feromap

CORS_ORIGINS=http://localhost:8080

# Vacío: el SPA usa /api en el mismo origen (Nginx → api:8000)
VITE_API_URL=
VITE_USE_MOCKS=false

# JWT (autenticación demo — cambiar JWT_SECRET en despliegue real)
JWT_SECRET=feromap-prod-secret-change-me
JWT_EXPIRE_MINUTES=1440
JWT_COOKIE_NAME=feromap_access_token

DATA_DIR=./data

# Motor ACO (defensa: UI en perfil «Preciso» vía VITE_ACO_PRESET_DEFAULT)
ACO_ANTS=12
ACO_ITERATIONS=20
ACO_PATIENCE=5
ACO_PARALLEL_WORKERS=0
OPTIMIZATION_MAX_WORKERS=2
VITE_ACO_PRESET_DEFAULT=precise
