APP_NAME="FEROMAP"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# dev = código montado (sin rebuild); prod = imágenes empaquetadas (compose.prod.yml)
COMPOSE_ENV=dev
COMPOSE_PROJECT_NAME=feromap

# Puertos expuestos en localhost
# dev:  5173 (Vite) + 8000 (API)
# prod: 8080 (Nginx SPA+proxy) + 8000 (API directo, opcional)
API_PORT=8000
FRONTEND_PORT=5173
DB_HOST_PORT=5432

# Desarrollo (contenedores): DB_HOST=db
# Producción (RDS/externo): DB_HOST=tu-endpoint.rds.amazonaws.com
DB_HOST=db
DB_PORT=5432
DB_DATABASE=feromap
DB_USERNAME=feromap
DB_PASSWORD=feromap

# URL de conexión (prod: definir explícitamente)
DATABASE_URL=postgresql+psycopg://feromap:feromap@db:5432/feromap

# CORS: origen del frontend
# dev:  http://localhost:5173
# prod: http://localhost:8080
CORS_ORIGINS=http://localhost:5173

# Frontend (Vite / build de producción)
# dev:  URL pública del API para fetch directo
# prod: dejar vacío — Nginx sirve /api en el mismo origen (puerto FRONTEND_PORT)
VITE_API_URL=http://localhost:8000

# Proxy de Vite en contenedor dev (servicio Docker «api»); en host local usar http://localhost:8000
VITE_API_PROXY_TARGET=http://api:8000

# Frontend: usar mocks locales en lugar de API (false = intentar backend primero)
VITE_USE_MOCKS=false

# Dev: mostrar toast cuando una vista cae a mock por fallo de API
VITE_MOCK_FALLBACK_TOAST=true

# JWT (autenticación demo)
JWT_SECRET=feromap-dev-secret-change-in-production
JWT_EXPIRE_MINUTES=1440
JWT_COOKIE_NAME=feromap_access_token

# Motor ACO — defaults por APP_ENV si no se definen explícitamente:
#   local → 6×10 | staging/production → 12×20
# ACO_PATIENCE=0 desactiva la parada anticipada.
ACO_ANTS=6
ACO_ITERATIONS=10
ACO_PATIENCE=5
# Hormigas en paralelo: 0=auto, 1=secuencial, N=procesos worker
ACO_PARALLEL_WORKERS=0
# Máximo de optimizaciones pesadas simultáneas en el servidor
OPTIMIZATION_MAX_WORKERS=2
# Máximo de puntos nuevos al parchear matriz desde caché (contingencia/submatriz)
MATRIX_INCREMENTAL_MAX_ADDITIONS=3

# Rutas a datos geoespaciales (montados en /app/data dentro del api)
DATA_DIR=./data
