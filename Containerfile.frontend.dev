# Desarrollo: Vite dev server con dependencias npm en la imagen.
# El código frontend se monta desde la raíz del monorepo (compose.dev.yml).
FROM docker.io/library/node:20-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

EXPOSE 5173

# CMD exec-form (evita scripts con CRLF al build en Windows)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
